# Copy to .env and adjust. Never commit real secrets.

POSTGRES_DB=smartparking
POSTGRES_USER=parking
POSTGRES_PASSWORD=change-me-now

# JDBC used by the backend container
DB_URL=jdbc:postgresql://postgres:5432/smartparking
DB_USERNAME=parking
DB_PASSWORD=change-me-now

# Must match mp.jwt.verify.issuer
JWT_ISSUER=smart-parking

# Frontend public origin (CORS)
FRONTEND_ORIGIN=http://localhost:8088
